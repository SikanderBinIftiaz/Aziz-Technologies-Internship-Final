# ---------- LLM ----------
# Leave ANTHROPIC_API_KEY empty to run in offline "demo mode" (retrieval only, no generation).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Prices used for the usage dashboard (USD per million tokens). Update to match your model's pricing.
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0
AGENT_MAX_STEPS=4
HISTORY_MESSAGES=6

# ---------- Embeddings and retrieval ----------
# auto  = use sentence-transformers if installed and downloadable, otherwise fall back to hashing embeddings
# local = require sentence-transformers
# hash  = lightweight offline embeddings (used by the test suite)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=6
# Optional: override the minimum similarity (0 to 1). If unset, a sensible default for the active embedder is used.
# SIMILARITY_THRESHOLD=0.30

# ---------- Storage ----------
DATABASE_URL=sqlite:///./data/documind.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute

# ---------- App ----------
# In APP_ENV=production the server refuses to start with the default JWT secret.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000
